{
  "id": "set_phase_mode",
  "title": {
    "en": "Set phase switching",
    "nl": "Fase-omschakeling instellen"
  },
  "titleFormatted": {
    "en": "Set phase switching to [[mode]]",
    "nl": "Fase-omschakeling instellen op [[mode]]"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=evc04|unite"
