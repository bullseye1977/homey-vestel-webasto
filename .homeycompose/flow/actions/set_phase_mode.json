    {
      "name": "mode",
      "type": "dropdown",
      "values": [
        {
          "id": "3",
          "title": {
            "en": "Always 3 phases",
            "nl": "Altijd 3 fasen"
          }
        },
        {
          "id": "auto",
          "title": {
            "en": "Automatic",
            "nl": "Automatisch"
          }
        },
        {
          "id": "1",
          "title": {
            "en": "Always 1 phase",
            "nl": "Altijd 1 fase"
          }
        }
      ]
    }
  ]
}