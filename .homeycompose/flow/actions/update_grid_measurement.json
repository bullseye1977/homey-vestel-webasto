        "en": "W"
      }
    },
    {
      "name": "l1",
      "type": "number",
      "placeholder": {
        "en": "L1 (A)"
      }
    },
    {
      "name": "l2",
      "type": "number",
      "placeholder": {
        "en": "L2 (A)"
      }
    },
    {
      "name": "l3",
      "type": "number",
      "placeholder": {
        "en": "L3 (A)"
      }
