[
  {
    "type": "group",
    "label": { "en": "Connection", "nl": "Verbinding" },
    "children": [
      { "id": "host", "type": "text", "label": { "en": "IP address", "nl": "IP-adres" }, "value": "" },
      { "id": "port", "type": "number", "label": { "en": "Port", "nl": "Poort" }, "value": 502, "min": 1, "max": 65535 },
      { "id": "unitId", "type": "number", "label": { "en": "Modbus unit ID", "nl": "Modbus unit-ID" }, "value": 255, "min": 0, "max": 255 },
      { "id": "pollInterval", "type": "number", "label": { "en": "Poll interval", "nl": "Uitleesinterval" }, "units": { "en": "s" }, "value": 5, "min": 2, "max": 60 }
    ]
  },
  {
    "type": "group",
    "label": { "en": "Charger", "nl": "Laadpaal" },
    "children": [
      { "id": "maxCurrent", "type": "number", "label": { "en": "Maximum current of the installation", "nl": "Maximale stroom van de installatie" }, "hint": { "en": "Never charge above this, whatever mode or flow asks for.", "nl": "Er wordt nooit harder geladen dan dit, wat een modus of flow ook vraagt." }, "units": { "en": "A" }, "value": 16, "min": 6, "max": 32 },
      { "id": "minCurrent", "type": "number", "label": { "en": "Minimum current", "nl": "Minimale stroom" }, "hint": { "en": "Below this the charger pauses. 6 A is the EV standard minimum.", "nl": "Daaronder pauzeert de laadpaal. 6 A is het minimum van de laadstandaard." }, "units": { "en": "A" }, "value": 6, "min": 6, "max": 16 },
      { "id": "phases", "type": "dropdown", "label": { "en": "Phases (fallback)", "nl": "Fasen (terugval)" }, "hint": { "en": "Used for solar calculations when the number of phases can't be measured yet.", "nl": "Gebruikt voor de zonneberekening zolang het aantal fasen nog niet gemeten kan worden." }, "value": "3", "values": [ { "id": "1", "label": { "en": "1 phase", "nl": "1 fase" } }, { "id": "3", "label": { "en": "3 phases", "nl": "3 fasen" } } ] }
    ]
  },
  {
    "type": "group",
    "label": { "en": "Solar charging", "nl": "Laden op zonne-overschot" },
    "children": [
      { "id": "solarBufferW", "type": "number", "label": { "en": "Reserve", "nl": "Reserve" }, "hint": { "en": "Keep this much power exported so you don't import from the grid.", "nl": "Houd zoveel vermogen over als teruglevering, zodat je niets van het net haalt." }, "units": { "en": "W" }, "value": 100, "min": -2000, "max": 2000 },
      { "id": "solarStartDelayS", "type": "number", "label": { "en": "Start delay", "nl": "Startvertraging" }, "units": { "en": "s" }, "value": 120, "min": 0, "max": 1800 },
      { "id": "solarStopDelayS", "type": "number", "label": { "en": "Stop delay", "nl": "Stopvertraging" }, "units": { "en": "s" }, "value": 300, "min": 0, "max": 3600 },
      { "id": "solarAdjustIntervalS", "type": "number", "label": { "en": "Adjust at most every", "nl": "Hoogstens aanpassen elke" }, "units": { "en": "s" }, "value": 30, "min": 5, "max": 600 }
    ]
  },
  {
    "type": "group",
    "label": { "en": "Load balancing", "nl": "Capaciteitsbeveiliging" },
    "children": [
      { "id": "loadBalancing", "type": "checkbox", "label": { "en": "Enabled", "nl": "Ingeschakeld" }, "hint": { "en": "Needs the 'Update grid measurement' flow card with currents per phase.", "nl": "Heeft de flowkaart 'Netmeting doorgeven' met stroom per fase nodig." }, "value": false },
      { "id": "mainFuseA", "type": "number", "label": { "en": "Main fuse per phase", "nl": "Hoofdzekering per fase" }, "hint": { "en": "Use a value slightly below your real fuse for margin, e.g. 23 for a 3x25A connection.", "nl": "Neem iets minder dan je echte zekering als marge, bijvoorbeeld 23 bij een 3x25A-aansluiting." }, "units": { "en": "A" }, "value": 23, "min": 6, "max": 80 },
      { "id": "gridTimeoutS", "type": "number", "label": { "en": "Grid data timeout", "nl": "Time-out netmeting" }, "hint": { "en": "Without fresh grid data, solar mode pauses and load balancing falls back to the minimum current.", "nl": "Zonder verse netmeting pauzeert zonneladen en valt capaciteitsbeveiliging terug op de minimale stroom." }, "units": { "en": "s" }, "value": 60, "min": 10, "max": 600 }
    ]
  },
  {
    "type": "group",
    "label": { "en": "Information", "nl": "Informatie" },
    "children": [
      { "id": "serial", "type": "label", "label": { "en": "Serial number", "nl": "Serienummer" }, "value": "" },
      { "id": "firmware", "type": "label", "label": { "en": "Firmware", "nl": "Firmware" }, "value": "" }
    ]
  }
]
