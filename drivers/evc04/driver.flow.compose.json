{
  "triggers": [
    {
      "id": "car_connected",
      "title": { "en": "Car was connected", "nl": "Auto is aangesloten" }
    },
    {
      "id": "car_disconnected",
      "title": { "en": "Car was disconnected", "nl": "Auto is losgekoppeld" },
      "tokens": [
        { "name": "energy", "type": "number", "title": { "en": "Session energy (kWh)", "nl": "Sessie-energie (kWh)" }, "example": 12.4 },
        { "name": "duration", "type": "number", "title": { "en": "Session duration (min)", "nl": "Sessieduur (min)" }, "example": 95 }
      ]
    },
    {
      "id": "charge_mode_changed",
      "title": { "en": "Charge mode changed", "nl": "Laadmodus is veranderd" },
      "tokens": [
        { "name": "mode", "type": "string", "title": { "en": "Mode", "nl": "Modus" }, "example": "solar" }
      ]
    }
  ],
  "conditions": [
    {
      "id": "is_car_connected",
      "title": { "en": "Car !{{is|is not}} connected", "nl": "Auto !{{is|is niet}} aangesloten" }
    },
    {
      "id": "charge_mode_is",
      "title": { "en": "Charge mode !{{is|is not}}", "nl": "Laadmodus !{{is|is niet}}" },
      "titleFormatted": { "en": "Charge mode !{{is|is not}} [[mode]]", "nl": "Laadmodus !{{is|is niet}} [[mode]]" },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            { "id": "fast", "title": { "en": "Fast", "nl": "Snel" } },
            { "id": "min_solar", "title": { "en": "Minimum + solar", "nl": "Minimaal + zon" } },
            { "id": "solar", "title": { "en": "Solar only", "nl": "Alleen zon" } },
            { "id": "off", "title": { "en": "Off", "nl": "Uit" } }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "set_charge_mode",
      "title": { "en": "Set charge mode", "nl": "Laadmodus instellen" },
      "titleFormatted": { "en": "Set charge mode to [[mode]]", "nl": "Laadmodus instellen op [[mode]]" },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            { "id": "fast", "title": { "en": "Fast", "nl": "Snel" } },
            { "id": "min_solar", "title": { "en": "Minimum + solar", "nl": "Minimaal + zon" } },
            { "id": "solar", "title": { "en": "Solar only", "nl": "Alleen zon" } },
            { "id": "off", "title": { "en": "Off", "nl": "Uit" } }
          ]
        }
      ]
    },
    {
      "id": "set_max_current",
      "title": { "en": "Set max charging current", "nl": "Max. laadstroom instellen" },
      "titleFormatted": { "en": "Set max charging current to [[current]] A", "nl": "Max. laadstroom instellen op [[current]] A" },
      "args": [
        { "name": "current", "type": "number", "min": 6, "max": 32, "step": 1, "placeholder": { "en": "16", "nl": "16" } }
      ]
    },
    {
      "id": "update_grid_power",
      "title": { "en": "Update grid power", "nl": "Netvermogen doorgeven" },
      "titleFormatted": { "en": "Grid power is [[power]] W", "nl": "Netvermogen is [[power]] W" },
      "hint": { "en": "Power from your P1 meter. Negative = exporting. Needed for solar charging.", "nl": "Vermogen van je P1-meter. Negatief = teruglevering. Nodig voor laden op zonne-overschot." },
      "args": [
        { "name": "power", "type": "number", "placeholder": { "en": "W" } }
      ]
    },
    {
      "id": "update_grid_measurement",
      "title": { "en": "Update grid measurement", "nl": "Netmeting doorgeven" },
      "titleFormatted": { "en": "Grid power [[power]] W, currents [[l1]] / [[l2]] / [[l3]] A", "nl": "Netvermogen [[power]] W, stroom [[l1]] / [[l2]] / [[l3]] A" },
      "hint": { "en": "Values from your P1 meter. Negative = exporting. Needed for solar charging and load balancing.", "nl": "Waarden van je P1-meter. Negatief = teruglevering. Nodig voor zonneladen en capaciteitsbeveiliging." },
      "args": [
        { "name": "power", "type": "number", "placeholder": { "en": "W" } },
        { "name": "l1", "type": "number", "placeholder": { "en": "L1 (A)" } },
        { "name": "l2", "type": "number", "placeholder": { "en": "L2 (A)" } },
        { "name": "l3", "type": "number", "placeholder": { "en": "L3 (A)" } }
      ]
    }
  ]
}
